---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/videos.css";
---

<BaseLayout
  title="Terms of Service — Lacrima Videos"
  description="Terms of service for Lacrima Videos CLI, the internal tool Lacrima Videos uses to manage its own YouTube channels."
  canonical="https://lacrima.dev/videos/terms/"
>
  <div class="landing">
    <header class="landing-header">
      <h1>Lacrima Videos</h1>
      <a href="/videos" class="landing-back">← Back to Lacrima Videos</a>
    </header>

    <main class="videos-doc">
      <h2>Terms of Service</h2>
      <p><strong>Last updated:</strong> October 20, 2026.</p>

      <p>
        These terms apply to Lacrima Videos CLI (the "Tool"), an internal application used by the
        Lacrima Videos team to manage our own YouTube channels.
      </p>

      <h3>Who can use it</h3>
      <p>
        The Tool is not offered to the public. Only members of the Lacrima Videos team, acting on
        channels we own, may use it.
      </p>

      <h3>YouTube</h3>
      <p>
        The Tool uses YouTube API Services. Anyone using the Tool agrees to be bound by the
        <a href="https://www.youtube.com/t/terms" target="_blank" rel="noopener noreferrer">YouTube Terms of Service</a>
        and the <a href="http://www.google.com/policies/privacy" target="_blank" rel="noopener noreferrer">Google Privacy Policy</a>.
        Every video is reviewed and approved by a person before it is uploaded, and must follow YouTube's
        Community Guidelines, including the disclosure of altered or synthetic content where it applies.
      </p>

      <h3>Data</h3>
      <p>
        How the Tool handles data is described in our <a href="/videos/privacy">Privacy Policy</a>.
        Access can be revoked at any time from
        <a href="https://security.google.com/settings/security/permissions" target="_blank" rel="noopener noreferrer">Google security settings</a>.
      </p>

      <h3>No warranty</h3>
      <p>The Tool is provided as is, for internal use, without warranties of any kind.</p>

      <h3>Contact</h3>
      <p><a href="mailto:lacrimadev@gmail.com">lacrimadev@gmail.com</a></p>
    </main>

    <footer class="landing-footer">
      <p><a href="mailto:lacrimadev@gmail.com">lacrimadev@gmail.com</a></p>
      <p><a href="/videos">← Lacrima Videos</a> · <a href="/videos/privacy">Privacy Policy</a></p>
    </footer>
  </div>
</BaseLayout>
